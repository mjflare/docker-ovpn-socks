# OpenVPN Proxy Server Configuration

# Directory containing your .ovpn file (absolute path)
OVPN_DIR=/opt/ovpn

# Port for the proxy server (1024-65535)
PROXY_PORT=8888

# Name of your OpenVPN config file inside OVPN_DIR
OVPN_CONFIG=client.ovpn

# Log level: info, notice, warn, error
LOG_LEVEL=info

# Docker Compose project name
COMPOSE_PROJECT_NAME=openvpn-proxy
